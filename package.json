{
  "name": "adaptive-english-interview-coach",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:speech": "sh scripts/start-with-speech.sh",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser-smoke.js",
    "test:browser:deep-links": "node test/browser-deep-links.js",
    "demo:seed": "node scripts/build-demo-seed.js",
    "evaluate": "node evaluation/run.js",
    "evaluate:release": "node evaluation/run.js --release",
    "codex:login": "node scripts/codex-account.js login",
    "codex:status": "node scripts/codex-account.js",
    "start:codex": "COACH_LANGUAGE_PROVIDER=codex COACH_SPEECH_PROVIDER=fake node src/server.js",
    "codex:verify": "node scripts/codex-verify.js"
  },
  "engines": {
    "node": ">=22"
  }
}
