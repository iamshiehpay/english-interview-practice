# This file is documentation only; npm start does not automatically load it.
# Export selected settings in your shell/secret manager. Never commit real keys.
COACH_LANGUAGE_PROVIDER=fake
COACH_SPEECH_PROVIDER=fake
COACH_MODEL=gpt-4.1-mini
# Speech-to-text for spoken answers, and text-to-speech for reading English
# practice text aloud. Both read OPENAI_API_KEY from this server process only;
# the key never reaches the browser, the workspace, test artifacts or Git.
COACH_SPEECH_MODEL=gpt-4o-mini-transcribe
COACH_TTS_MODEL=gpt-4o-mini-tts
COACH_TTS_VOICE=alloy
COACH_TIMEOUT_MS=30000
PORT=4310
# WORKSPACE_DIR=/absolute/local/workspace
# GREENHOUSE_BOARD=public_board_token
# OPENAI_API_KEY=<set securely outside application data>

# Optional ChatGPT subscription text provider (Codex CLI 0.154.0):
# COACH_LANGUAGE_PROVIDER=codex
# COACH_CODEX_HOME=/absolute/dedicated/.coach-codex
# COACH_CODEX_BIN=codex
# COACH_CODEX_MODEL=gpt-5.6-luna
# Reasoning effort per call (low|medium|high|xhigh); higher is slower.
# COACH_CODEX_EFFORT=xhigh
# Default operation timeout becomes 180000ms for Codex (xhigh reasoning is slow).
# Run npm run codex:login, then codex:verify.
# Official Codex OAuth uses private .coach-codex/auth.json (plaintext,0600), not the practice database.
# Several public boards can be searched together (comma-separated).
# GREENHOUSE_BOARDS=board_one,board_two

# Keeping speech credentials in a file: the application never reads a file, only
# process.env. `npm run start:speech` sources ~/.config/interview-coach/speech.env
# (override with COACH_SPEECH_ENV) into the server process and starts the server.
