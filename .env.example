# This file is documentation only; npm start does not automatically load it.
# Export selected settings in your shell/secret manager. Never commit real keys.
COACH_LANGUAGE_PROVIDER=fake
COACH_SPEECH_PROVIDER=fake
COACH_MODEL=gpt-4.1-mini
COACH_SPEECH_MODEL=gpt-4o-mini-transcribe
COACH_TIMEOUT_MS=30000
PORT=4310
# WORKSPACE_DIR=/absolute/local/workspace
# GREENHOUSE_BOARD=public_board_token
# OPENAI_API_KEY=<set securely outside application data>

# Optional ChatGPT subscription text provider (Codex CLI 0.154.0):
# COACH_LANGUAGE_PROVIDER=codex
# COACH_CODEX_HOME=/absolute/dedicated/.coach-codex
# COACH_CODEX_BIN=codex
# COACH_CODEX_MODEL=gpt-5.6-sol
# Default operation timeout becomes 90000ms for Codex.
# Run npm run codex:login, then codex:verify.
# Official Codex OAuth uses private .coach-codex/auth.json (plaintext,0600), not the practice database.
